class Solution:
    def hasValidPath(self, grid: List[List[int]]) -> bool:
        m, n = len(grid), len(grid[0])
        q = collections.deque([(0, 0)])
        v = {(0, 0)}
        
        d = {
            1: [(0, -1), (0, 1)],
            2: [(-1, 0), (1, 0)],
            3: [(0, -1), (1, 0)],
            4: [(0, 1), (1, 0)],
            5: [(0, -1), (-1, 0)],
            6: [(0, 1), (-1, 0)]
        }
        
        while q:
            r, c = q.popleft()
            if r == m - 1 and c == n - 1:
                return True
            
            for dr, dc in d[grid[r][c]]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < m and 0 <= nc < n and (nr, nc) not in v:
                    for back_dr, back_dc in d[grid[nr][nc]]:
                        if nr + back_dr == r and nc + back_dc == c:
                            v.add((nr, nc))
                            q.append((nr, nc))
                            break
                            
        return False
