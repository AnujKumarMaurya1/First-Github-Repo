class Solution:
    def isGood(self, nums: list[int]) -> bool:
        n = len(nums) - 1
        if n <= 0:
            return False
            
        count = [0] * (n + 1)
        for num in nums:
            if num > n or num < 1:
                return False
            count[num] += 1
            
        for i in range(1, n):
            if count[i] != 1:
                return False
                
        return count[n] == 2
