class Solution:
    def canPartitionGrid(self, grid: List[List[int]]) -> bool:
        m = len(grid)
        n = len(grid[0])
        
        row_sums = []
        for row in grid:
            row_sums.append(sum(row))
            
        col_sums = [0] * n
        for r in range(m):
            for c in range(n):
                col_sums[c] += grid[r][c]
                
        total = sum(row_sums)
        
        if total % 2 != 0:
            return False
            
        target = total // 2
        
        current_row_sum = 0
        for i in range(m - 1):
            current_row_sum += row_sums[i]
            if current_row_sum == target:
                return True
                
        current_col_sum = 0
        for j in range(n - 1):
            current_col_sum += col_sums[j]
            if current_col_sum == target:
                return True
                
        return False
