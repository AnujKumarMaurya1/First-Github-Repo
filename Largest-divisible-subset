class Solution:
    def largestDivisibleSubset(self, nums: List[int]) -> List[int]:
        if not nums:
            return []
        
        nums.sort()
        n = len(nums)
        
        dp = [1] * n
        prev = [-1] * n
        
        best_size = 0
        best_idx = 0
        
        for i in range(n):
            for j in range(i):
                if nums[i] % nums[j] == 0:
                    if dp[i] < dp[j] + 1:
                        dp[i] = dp[j] + 1
                        prev[i] = j
            
            if dp[i] > best_size:
                best_size = dp[i]
                best_idx = i
        
        res = []
        curr = best_idx
        while curr != -1:
            res.append(nums[curr])
            curr = prev[curr]
            
        return res[::-1]
