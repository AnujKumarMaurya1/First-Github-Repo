from typing import List

class Solution:
    def maxSumTrionic(self, nums: List[int]) -> int:
        n = len(nums)
        inf = float('inf')
        
        inc = [-inf] * n
        for i in range(1, n):
            if nums[i] > nums[i-1]:
                inc[i] = max(nums[i-1] + nums[i], inc[i-1] + nums[i])
        
        s2 = [-inf] * n
        for i in range(2, n):
            if nums[i] < nums[i-1]:
                res = s2[i-1] + nums[i]
                if inc[i-1] != -inf:
                    res = max(res, inc[i-1] + nums[i])
                s2[i] = res
                
        s3 = [-inf] * n
        for i in range(3, n):
            if nums[i] > nums[i-1]:
                res = s3[i-1] + nums[i]
                if s2[i-1] != -inf:
                    res = max(res, s2[i-1] + nums[i])
                s3[i] = res
                
        ans = -inf
        for i in range(3, n):
            if s3[i] > ans:
                ans = s3[i]
            
        return int(ans)
