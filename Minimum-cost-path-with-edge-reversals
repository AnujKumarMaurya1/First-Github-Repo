class Solution:
    def minCost(self, n: int, edges: List[List[int]]) -> int:
        import heapq
        
        g = [[] for _ in range(n)]
        rg = [[] for _ in range(n)]
        
        for u, v, w in edges:
            g[u].append((v, w))
            rg[v].append((u, w))
        
        INF = 10**18
        dist = [[INF, INF] for _ in range(n)]
        dist[0][0] = 0
        
        pq = [(0, 0, 0)]
        
        while pq:
            d, u, s = heapq.heappop(pq)
            if d != dist[u][s]:
                continue
            
            for v, w in g[u]:
                nd = d + w
                if nd < dist[v][s]:
                    dist[v][s] = nd
                    heapq.heappush(pq, (nd, v, s))
            
            if s == 0:
                for v, w in rg[u]:
                    nd = d + 2*w
                    if nd < dist[v][1]:
                        dist[v][1] = nd
                        heapq.heappush(pq, (nd, v, 1))
        
        ans = min(dist[n-1][0], dist[n-1][1])
        return -1 if ans == INF else ans
