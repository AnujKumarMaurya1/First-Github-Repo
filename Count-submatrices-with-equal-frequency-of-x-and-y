class Solution:
    def numberOfSubmatrices(self, grid: List[List[str]]) -> int:
        rows = len(grid)
        cols = len(grid[0])
        
        diff_matrix = [[0] * cols for _ in range(rows)]
        x_count_matrix = [[0] * cols for _ in range(rows)]
        
        res = 0
        
        for r in range(rows):
            for c in range(cols):
                val = 0
                if grid[r][c] == 'X':
                    val = 1
                elif grid[r][c] == 'Y':
                    val = -1
                
                has_x = 1 if grid[r][c] == 'X' else 0
                
                top_diff = diff_matrix[r-1][c] if r > 0 else 0
                left_diff = diff_matrix[r][c-1] if c > 0 else 0
                diag_diff = diff_matrix[r-1][c-1] if (r > 0 and c > 0) else 0
                diff_matrix[r][c] = val + top_diff + left_diff - diag_diff
                
                top_x = x_count_matrix[r-1][c] if r > 0 else 0
                left_x = x_count_matrix[r][c-1] if c > 0 else 0
                diag_x = x_count_matrix[r-1][c-1] if (r > 0 and c > 0) else 0
                x_count_matrix[r][c] = has_x + top_x + left_x - diag_x
                
                if diff_matrix[r][c] == 0 and x_count_matrix[r][c] > 0:
                    res += 1
                    
        return res
