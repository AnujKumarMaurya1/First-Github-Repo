class Solution:
    def minCut(self, s: str) -> int:
        n = len(s)
        is_pal = [[False] * n for _ in range(n)]
        
        for length in range(1, n + 1):
            for i in range(n - length + 1):
                j = i + length - 1
                if s[i] == s[j]:
                    if length <= 2 or is_pal[i+1][j-1]:
                        is_pal[i][j] = True
        
        dp = [0] * n
        for i in range(n):
            if is_pal[0][i]:
                dp[i] = 0
                continue
            
            res = i
            for j in range(i):
                if is_pal[j+1][i]:
                    res = min(res, dp[j] + 1)
            dp[i] = res
            
        return dp[n-1]
