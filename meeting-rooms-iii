import bisect

class Solution:
    def maxSumSubmatrix(self, matrix: list[list[int]], k: int) -> int:
        m, n = len(matrix), len(matrix[0])
        max_sum = float('-inf')
        
        col_driven = n < m
        outer_limit = n if col_driven else m
        inner_limit = m if col_driven else n
        
        for i in range(outer_limit):
            sums = [0] * inner_limit
            for j in range(i, outer_limit):
                for r in range(inner_limit):
                    sums[r] += matrix[r][j] if col_driven else matrix[j][r]
                
                prefix_sums = [0]
                current_prefix = 0
                for s in sums:
                    current_prefix += s
                    idx = bisect.bisect_left(prefix_sums, current_prefix - k)
                    if idx < len(prefix_sums):
                        max_sum = max(max_sum, current_prefix - prefix_sums[idx])
                        if max_sum == k:
                            return k
                    bisect.insort(prefix_sums, current_prefix)
                    
        return max_sum
