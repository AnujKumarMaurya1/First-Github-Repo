class Solution:
    def gameOfLife(self, board: list[list[int]]) -> None:
        if not board or not board[0]:
            return
            
        m, n = len(board), len(board[0])
        
        # 2: live -> dead
        # 3: dead -> live
        for r in range(m):
            for c in range(n):
                live_neighbors = 0
                for dr in [-1, 0, 1]:
                    for dc in [-1, 0, 1]:
                        if dr == 0 and dc == 0:
                            continue
                        nr, nc = r + dr, c + dc
                        if 0 <= nr < m and 0 <= nc < n and (board[nr][nc] == 1 or board[nr][nc] == 2):
                            live_neighbors += 1
                
                if board[r][c] == 1:
                    if live_neighbors < 2 or live_neighbors > 3:
                        board[r][c] = 2
                else:
                    if live_neighbors == 3:
                        board[r][c] = 3
                        
        for r in range(m):
            for c in range(n):
                if board[r][c] == 2:
                    board[r][c] = 0
                elif board[r][c] == 3:
                    board[r][c] = 1
