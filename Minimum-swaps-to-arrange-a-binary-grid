class Solution:
    def minSwaps(self, grid):
        n = len(grid)
        zeros = []

        for row in grid:
            count = 0
            for i in range(n - 1, -1, -1):
                if row[i] == 0:
                    count += 1
                else:
                    break
            zeros.append(count)

        total_swaps = 0
        
        for i in range(n):
            needed = n - 1 - i
            found_idx = -1
            
            for j in range(i, n):
                if zeros[j] >= needed:
                    found_idx = j
                    break
            
            if found_idx == -1:
                return -1
            
            total_swaps += (found_idx - i)
            
            val = zeros.pop(found_idx)
            zeros.insert(i, val)
            
        return total_swaps
