from math import gcd
from collections import defaultdict

class Solution:
    def countTrapezoids(self, points: List[List[int]]) -> int:
        n = len(points)
        slope_to_intercepts = defaultdict(list)
        mid_to_slopes = defaultdict(list)
        ans = 0

        for i in range(n):
            x1, y1 = points[i]
            for j in range(i + 1, n):
                x2, y2 = points[j]
                
                dy = y1 - y2
                dx = x1 - x2
                
                if dx == 0:
                    slope = (1, 0)
                    intercept = x1
                elif dy == 0:
                    slope = (0, 1)
                    intercept = y1
                else:
                    common = gcd(dy, dx)
                    dy //= common
                    dx //= common
                    if dx < 0:
                        dx, dy = -dx, -dy
                    slope = (dy, dx)
                    intercept = dy * x1 - dx * y1
                
                mid = (x1 + x2, y1 + y2)
                slope_to_intercepts[slope].append(intercept)
                mid_to_slopes[mid].append(slope)

        for intercepts in slope_to_intercepts.values():
            if len(intercepts) < 2:
                continue
            
            counts = defaultdict(int)
            for b in intercepts:
                counts[b] += 1
            
            total_segments = len(intercepts)
            collinear_pairs = 0
            for c in counts.values():
                collinear_pairs += (c * (c - 1)) // 2
            
            ans += (total_segments * (total_segments - 1)) // 2 - collinear_pairs

        for slopes in mid_to_slopes.values():
            if len(slopes) < 2:
                continue
            
            counts = defaultdict(int)
            for s in slopes:
                counts[s] += 1
            
            current_sum = 0
            for c in counts.values():
                ans -= current_sum * c
                current_sum += c

        return ans
