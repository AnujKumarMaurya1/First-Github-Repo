class Solution:
    def findTheString(self, lcp: List[List[int]]) -> str:
        n = len(lcp)
        word = [None] * n
        char_code = ord('a')
        
        for i in range(n):
            if word[i] is not None:
                continue
            if char_code > ord('z'):
                return ""
            
            curr_char = chr(char_code)
            for j in range(i, n):
                if lcp[i][j] > 0:
                    word[j] = curr_char
            char_code += 1
            
        if None in word:
            return ""
        
        res = "".join(word)
        
        for i in range(n - 1, -1, -1):
            for j in range(n - 1, -1, -1):
                expected = 0
                if res[i] == res[j]:
                    if i == n - 1 or j == n - 1:
                        expected = 1
                    else:
                        expected = 1 + lcp[i + 1][j + 1]
                
                if lcp[i][j] != expected:
                    return ""
                    
        return res
