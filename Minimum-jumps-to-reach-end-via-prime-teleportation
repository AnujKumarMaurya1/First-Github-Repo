import collections

class Solution:
    def minJumps(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 1:
            return 0
        
        max_val = max(nums)
        spf = list(range(max_val + 1))
        for i in range(2, int(max_val**0.5) + 1):
            if spf[i] == i:
                for j in range(i * i, max_val + 1, i):
                    if spf[j] == j:
                        spf[j] = i
        
        prime_to_indices = collections.defaultdict(list)
        for i, val in enumerate(nums):
            temp = val
            while temp > 1:
                p = spf[temp]
                prime_to_indices[p].append(i)
                while temp % p == 0:
                    temp //= p
        
        is_prime = [True] * (max_val + 1)
        is_prime[0] = is_prime[1] = False
        for i in range(2, int(max_val**0.5) + 1):
            if is_prime[i]:
                for j in range(i * i, max_val + 1, i):
                    is_prime[j] = False

        q = collections.deque([(0, 0)])
        visited_indices = {0}
        used_primes = set()
        
        while q:
            idx, dist = q.popleft()
            
            if idx == n - 1:
                return dist
            
            for nxt in [idx - 1, idx + 1]:
                if 0 <= nxt < n and nxt not in visited_indices:
                    visited_indices.add(nxt)
                    q.append((nxt, dist + 1))
            
            val = nums[idx]
            if val <= max_val and is_prime[val]:
                if val not in used_primes:
                    for nxt in prime_to_indices[val]:
                        if nxt not in visited_indices:
                            visited_indices.add(nxt)
                            q.append((nxt, dist + 1))
                    used_primes.add(val)
                    
        return -1
