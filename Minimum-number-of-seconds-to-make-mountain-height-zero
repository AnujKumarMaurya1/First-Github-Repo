import math

class Solution:
    def minNumberOfSeconds(self, mountainHeight: int, workerTimes: list[int]) -> int:
        def can_finish(max_time):
            total_reduction = 0
            for w in workerTimes:
                x = int((-1 + math.sqrt(1 + (8 * max_time // w))) // 2)
                total_reduction += x
                if total_reduction >= mountainHeight:
                    return True
            return False

        low = 1
        high = min(workerTimes) * mountainHeight * (mountainHeight + 1) // 2
        ans = high
        
        while low <= high:
            mid = (low + high) // 2
            if can_finish(mid):
                ans = mid
                high = mid - 1
            else:
                low = mid + 1
                
        return ans
