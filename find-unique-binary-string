class Solution:
    def findDifferentBinaryString(self, nums: list[str]) -> str:
        res = []
        for i in range(len(nums)):
            # Flip the i-th character of the i-th string
            if nums[i][i] == "0":
                res.append("1")
            else:
                res.append("0")
        
        return "".join(res)
