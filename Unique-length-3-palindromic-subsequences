class Solution:
    def countPalindromicSubsequence(self, s: str) -> int:
        first = [-1] * 26
        last = [-1] * 26
        
        for i, char in enumerate(s):
            idx = ord(char) - ord('a')
            if first[idx] == -1:
                first[idx] = i
            last[idx] = i
            
        res = 0
        for i in range(26):
            if first[i] != -1 and last[i] > first[i] + 1:
                middle_chars = set(s[first[i] + 1 : last[i]])
                res += len(middle_chars)
                
        return res
