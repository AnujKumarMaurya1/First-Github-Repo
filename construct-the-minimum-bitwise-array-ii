class Solution:
    def minBitwiseArray(self, nums: List[int]) -> List[int]:
        ans = []
        for p in nums:
            if p == 2:
                ans.append(-1)
                continue
            temp = p
            count = 0
            while temp & 1:
                count += 1
                temp >>= 1
            res = p ^ (1 << (count - 1))
            ans.append(res)
            
        return ans
