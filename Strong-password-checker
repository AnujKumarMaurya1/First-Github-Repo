class Solution:
    def strongPasswordChecker(self, password: str) -> int:
        n = len(password)
        
        has_lower = any(c.islower() for c in password)
        has_upper = any(c.isupper() for c in password)
        has_digit = any(c.isdigit() for c in password)
        missing_types = (1 - has_lower) + (1 - has_upper) + (1 - has_digit)
        
        repeats = []
        i = 0
        while i < n:
            j = i
            while j < n and password[j] == password[i]:
                j += 1
            length = j - i
            if length >= 3:
                repeats.append(length)
            i = j

        if n < 6:
            return max(6 - n, missing_types)
            
        elif n <= 20:
            replace_needed = sum(length // 3 for length in repeats)
            return max(replace_needed, missing_types)
            
        else:
            deletes_needed = n - 20
            rem = deletes_needed
            
            for idx, length in enumerate(repeats):
                if rem >= 1 and length % 3 == 0:
                    repeats[idx] -= 1
                    rem -= 1
            
            for idx, length in enumerate(repeats):
                if rem >= 2 and length % 3 == 1:
                    repeats[idx] -= 2
                    rem -= 2
                    
            for idx, length in enumerate(repeats):
                if rem > 0 and length >= 3:
                    actual_del = min(rem, length - 2)
                    repeats[idx] -= actual_del
                    rem -= actual_del
                    
            replace_needed = sum(length // 3 for length in repeats if length >= 3)
            return deletes_needed + max(replace_needed, missing_types)
