class Solution:
    def originalDigits(self, s: str) -> str:
        counts = {}
        for char in s:
            counts[char] = counts.get(char, 0) + 1
            
        digit_counts = [0] * 10
        
        digit_counts[0] = counts.get('z', 0)
        digit_counts[2] = counts.get('w', 0)
        digit_counts[4] = counts.get('u', 0)
        digit_counts[6] = counts.get('x', 0)
        digit_counts[8] = counts.get('g', 0)
        
        digit_counts[3] = counts.get('h', 0) - digit_counts[8]
        digit_counts[5] = counts.get('f', 0) - digit_counts[4]
        digit_counts[7] = counts.get('s', 0) - digit_counts[6]
        
        digit_counts[1] = counts.get('o', 0) - digit_counts[0] - digit_counts[2] - digit_counts[4]
        digit_counts[9] = counts.get('i', 0) - digit_counts[5] - digit_counts[6] - digit_counts[8]
        
        result = []
        for digit in range(10):
            if digit_counts[digit] > 0:
                result.append(str(digit) * digit_counts[digit])
                
        return "".join(result)
