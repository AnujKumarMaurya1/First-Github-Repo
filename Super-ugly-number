import heapq

class Solution:
    def nthSuperUglyNumber(self, n: int, primes: list[int]) -> int:
        uglies = [0] * n
        uglies[0] = 1
        
        pq = []
        for p in primes:
            heapq.heappush(pq, (p, p, 0))
            
        for i in range(1, n):
            current_min = pq[0][0]
            uglies[i] = current_min
            
            while pq and pq[0][0] == current_min:
                val, p, idx = heapq.heappop(pq)
                heapq.heappush(pq, (p * uglies[idx + 1], p, idx + 1))
                
        return uglies[-1]
