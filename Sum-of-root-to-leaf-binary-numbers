class Solution:
    def sumRootToLeaf(self, root: Optional[TreeNode]) -> int:
        def calculate_path_sum(node, current_val):
            if not node:
                return 0
            
            current_val = (current_val << 1) | node.val
            
            if not node.left and not node.right:
                return current_val
            
            return calculate_path_sum(node.left, current_val) + calculate_path_sum(node.right, current_val)
        
        return calculate_path_sum(root, 0)
