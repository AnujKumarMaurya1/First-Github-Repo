class Solution:
    def rotateGrid(self, grid: list[list[int]], k: int) -> list[list[int]]:
        m, n = len(grid), len(grid[0])
        layers = min(m, n) // 2
        
        for l in range(layers):
            layer_elements = []
            
            # top
            for j in range(l, n - l - 1):
                layer_elements.append(grid[l][j])
            # right
            for i in range(l, m - l - 1):
                layer_elements.append(grid[i][n - l - 1])
            # bottom
            for j in range(n - l - 1, l, -1):
                layer_elements.append(grid[m - l - 1][j])
            # left
            for i in range(m - l - 1, l, -1):
                layer_elements.append(grid[i][l])
                
            length = len(layer_elements)
            shift = k % length
            rotated = layer_elements[shift:] + layer_elements[:shift]
            
            idx = 0
            for j in range(l, n - l - 1):
                grid[l][j] = rotated[idx]
                idx += 1
            for i in range(l, m - l - 1):
                grid[i][n - l - 1] = rotated[idx]
                idx += 1
            for j in range(n - l - 1, l, -1):
                grid[m - l - 1][j] = rotated[idx]
                idx += 1
            for i in range(m - l - 1, l, -1):
                grid[i][l] = rotated[idx]
                idx += 1
                
        return grid
