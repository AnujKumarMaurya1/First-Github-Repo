class Solution:
    def maxSubArray(self, nums: List[int]) -> int:
        current_sum = 0
        max_sum = nums[0]
        
        for x in nums:
            if current_sum < 0:
                current_sum = 0
            
            current_sum += x
            if current_sum > max_sum:
                max_sum = current_sum
                
        return max_sum
