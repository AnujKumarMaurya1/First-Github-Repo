class Solution:
    def minAbsDiff(self, grid: List[List[int]], k: int) -> List[List[int]]:
        m, n = len(grid), len(grid[0])
        res_rows, res_cols = m - k + 1, n - k + 1
        ans = [[0] * res_cols for _ in range(res_rows)]
        
        for i in range(res_rows):
            for j in range(res_cols):
                unique_elements = set()
                
                for r in range(i, i + k):
                    for c in range(j, j + k):
                        unique_elements.add(grid[r][c])
                
                if len(unique_elements) < 2:
                    ans[i][j] = 0
                    continue
                
                sorted_vals = sorted(list(unique_elements))
                min_diff = float('inf')
                
                for idx in range(1, len(sorted_vals)):
                    diff = sorted_vals[idx] - sorted_vals[idx - 1]
                    if diff < min_diff:
                        min_diff = diff
                
                ans[i][j] = min_diff
                
        return ans
