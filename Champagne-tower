class Solution:
    def champagneTower(self, poured: int, query_row: int, query_glass: int) -> float:
        res = [poured] + [0] * query_row
        
        for i in range(1, query_row + 1):
            for j in range(i, -1, -1):
                # Calculate flow from the glass above (left side)
                left = max(0, (res[j-1] - 1) / 2.0) if j > 0 else 0
                # Calculate flow from the glass above (right side)
                right = max(0, (res[j] - 1) / 2.0) if j < i else 0
                
                res[j] = left + right
                
        return min(1.0, res[query_glass])
