class Solution:
    def maxJumps(self, arr: list[int], d: int) -> int:
        n = len(arr)
        memo = [-1] * n
        
        def dfs(i):
            if memo[i] != -1:
                return memo[i]
                
            max_visited = 1
            
            for x in range(1, d + 1):
                if i + x >= n or arr[i + x] >= arr[i]:
                    break
                max_visited = max(max_visited, 1 + dfs(i + x))
                
            for x in range(1, d + 1):
                if i - x < 0 or arr[i - x] >= arr[i]:
                    break
                max_visited = max(max_visited, 1 + dfs(i - x))
                
            memo[i] = max_visited
            return max_visited

        return max(dfs(i) for i in range(n))
