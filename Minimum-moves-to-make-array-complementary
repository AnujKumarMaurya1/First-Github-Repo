from collections import Counter

class Solution:
    def minMoves(self, nums: list[int], limit: int) -> int:
        n = len(nums)
        diff = [0] * (2 * limit + 2)
        
        for i in range(n // 2):
            a, b = nums[i], nums[n - 1 - i]
            
            # 0 moves: target is exactly a + b
            # 1 move: target is in [min(a, b) + 1, max(a, b) + limit]
            # 2 moves: target is in [2, 2 * limit]
            
            # Default to 2 moves for everything
            diff[2] += 2
            diff[2 * limit + 1] -= 2
            
            # Reduce to 1 move for the range possible by changing one number
            l, r = min(a, b) + 1, max(a, b) + limit
            diff[l] -= 1
            diff[r + 1] += 1
            
            # Reduce to 0 moves for the specific current sum
            diff[a + b] -= 1
            diff[a + b + 1] += 1
            
        res = n
        curr = 0
        for i in range(2, 2 * limit + 1):
            curr += diff[i]
            res = min(res, curr)
            
        return res
