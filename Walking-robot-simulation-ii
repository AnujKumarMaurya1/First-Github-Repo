class Robot:
    def __init__(self, width: int, height: int):
        self.w = width
        self.h = height
        self.perimeter = 2 * (width + height - 2)
        self.pos = 0
        self.has_moved = False

    def step(self, num: int) -> None:
        self.has_moved = True
        # Use the perimeter to skip redundant loops
        self.pos = (self.pos + num) % self.perimeter

    def getPos(self) -> list[int]:
        d = self.pos
        if d < self.w:
            return [d, 0]
        if d < self.w + self.h - 1:
            return [self.w - 1, d - (self.w - 1)]
        if d < 2 * self.w + self.h - 2:
            return [self.w - 1 - (d - (self.w + self.h - 2)), self.h - 1]
        return [0, self.h - 1 - (d - (2 * self.w + self.h - 3))]

    def getDir(self) -> str:
        d = self.pos
        # Case 1: Has not moved yet
        if not self.has_moved:
            return "East"
        
        # Case 2: Has moved and is at origin (after a full lap or more)
        if d == 0:
            return "South"
            
        # Case 3: Anywhere else on the perimeter
        if 1 <= d < self.w:
            return "East"
        elif self.w <= d < self.w + self.h - 1:
            return "North"
        elif self.w + self.h - 1 <= d < 2 * self.w + self.h - 2:
            return "West"
        else:
            return "South"
