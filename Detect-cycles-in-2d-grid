class Solution:
    def containsCycle(self, grid: List[List[str]]) -> bool:
        m, n = len(grid), len(grid[0])
        visited = set()

        def dfs(r, c, pr, pc, val):
            visited.add((r, c))
            
            for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
                nr, nc = r + dr, c + dc
                
                if 0 <= nr < m and 0 <= nc < n and grid[nr][nc] == val:
                    if (nr, nc) == (pr, pc):
                        continue
                    if (nr, nc) in visited:
                        return True
                    if dfs(nr, nc, r, c, val):
                        return True
            return False

        for r in range(m):
            for c in range(n):
                if (r, c) not in visited:
                    if dfs(r, c, -1, -1, grid[r][c]):
                        return True
        return False
