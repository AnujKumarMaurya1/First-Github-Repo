from collections import Counter

class Solution:
    def canPartitionGrid(self, grid: List[List[int]]) -> bool:
        m = len(grid)
        n = len(grid[0])
        
        row_sums = [sum(r) for r in grid]
        col_sums = [0] * n
        for r in range(m):
            for c in range(n):
                col_sums[c] += grid[r][c]
        
        total = sum(row_sums)
        
        def check_h():
            s1, s2 = 0, total
            c1, c2 = Counter(), Counter()
            for r in range(m):
                for val in grid[r]:
                    c2[val] += 1
            
            for i in range(m - 1):
                s1 += row_sums[i]
                s2 -= row_sums[i]
                for val in grid[i]:
                    c1[val] += 1
                    c2[val] -= 1
                
                diff = abs(s1 - s2)
                if diff == 0: return True
                
                if s1 > s2:
                    if c1[diff] > 0:
                        h = i + 1
                        if h > 1 and n > 1: return True
                        if h == 1 and (grid[0][0] == diff or grid[0][n-1] == diff): return True
                        if n == 1 and (grid[0][0] == diff or grid[i][0] == diff): return True
                else:
                    if c2[diff] > 0:
                        h = m - 1 - i
                        if h > 1 and n > 1: return True
                        if h == 1 and (grid[i+1][0] == diff or grid[i+1][n-1] == diff): return True
                        if n == 1 and (grid[i+1][0] == diff or grid[m-1][0] == diff): return True
            return False

        def check_v():
            s1, s2 = 0, total
            c1, c2 = Counter(), Counter()
            for r in range(m):
                for c in range(n):
                    c2[grid[r][c]] += 1
            
            for j in range(n - 1):
                s1 += col_sums[j]
                s2 -= col_sums[j]
                for r in range(m):
                    val = grid[r][j]
                    c1[val] += 1
                    c2[val] -= 1
                
                diff = abs(s1 - s2)
                if diff == 0: return True
                
                if s1 > s2:
                    if c1[diff] > 0:
                        w = j + 1
                        if m > 1 and w > 1: return True
                        if w == 1 and (grid[0][0] == diff or grid[m-1][0] == diff): return True
                        if m == 1 and (grid[0][0] == diff or grid[0][j] == diff): return True
                else:
                    if c2[diff] > 0:
                        w = n - 1 - j
                        if m > 1 and w > 1: return True
                        if w == 1 and (grid[0][j+1] == diff or grid[m-1][j+1] == diff): return True
                        if m == 1 and (grid[0][j+1] == diff or grid[0][n-1] == diff): return True
            return False

        return check_h() or check_v()
